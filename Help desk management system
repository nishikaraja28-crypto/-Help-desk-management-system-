
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Ticket {
    int id;
    char name[50];
    char issue[100];
    char status[20];
    struct Ticket *next;
};

struct Ticket *head = NULL;

void registerTicket() {
    struct Ticket *newNode, *temp;

    newNode = (struct Ticket *)malloc(sizeof(struct Ticket));

    if (newNode == NULL) {
        printf("Memory allocation failed!\n");
        return;
    }

    printf("Enter Ticket ID: ");
    scanf("%d", &newNode->id);

    printf("Enter Name: ");
    scanf(" %49[^\n]", newNode->name);

    printf("Enter Issue: ");
    scanf(" %99[^\n]", newNode->issue);

    strcpy(newNode->status, "Pending");
    newNode->next = NULL;

    if (head == NULL) {
        head = newNode;
    } else {
        temp = head;
        while (temp->next != NULL)
            temp = temp->next;
        temp->next = newNode;
    }

    printf("Ticket Registered Successfully!\n");
}

void viewTickets() {
    struct Ticket *temp = head;

    if (temp == NULL) {
        printf("No tickets available!\n");
        return;
    }

    while (temp != NULL) {
        printf("\nTicket ID: %d", temp->id);
        printf("\nName: %s", temp->name);
        printf("\nIssue: %s", temp->issue);
        printf("\nStatus: %s\n", temp->status);
        temp = temp->next;
    }
}

void searchTicket() {
    int id;
    struct Ticket *temp = head;

    printf("Enter Ticket ID to search: ");
    scanf("%d", &id);

    while (temp != NULL) {
        if (temp->id == id) {
            printf("Ticket Found!\n");
            printf("Name: %s\n", temp->name);
            printf("Issue: %s\n", temp->issue);
            printf("Status: %s\n", temp->status);
            return;
        }
        temp = temp->next;
    }

    printf("Ticket Not Found!\n");
}

void resolveTicket() {
    int id;
    struct Ticket *temp = head;

    printf("Enter Ticket ID to resolve: ");
    scanf("%d", &id);

    while (temp != NULL) {
        if (temp->id == id) {
            strcpy(temp->status, "Resolved");
            printf("Ticket Resolved Successfully!\n");
            return;
        }
        temp = temp->next;
    }

    printf("Ticket Not Found!\n");
}

int main() {
    int choice;

    do {
        printf("\n\n--- HELP DESK MANAGEMENT SYSTEM ---\n");
        printf("1. Register Ticket\n");
        printf("2. View All Tickets\n");
        printf("3. Search Ticket\n");
        printf("4. Resolve Ticket\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                registerTicket();
                break;
            case 2:
                viewTickets();
                break;
            case 3:
                searchTicket();
                break;
            case 4:
                resolveTicket();
                break;
            case 5:
                printf("Thank You!\n");
                break;
            default:
                printf("Invalid Choice!\n");
        }
    } while (choice != 5);

    return 0;
}
